{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wf-meta",
  "title": "多智能体工作流产物头（wf-meta）",
  "description": "每份阶段产物第一段固定注释头的参数契约。",
  "type": "object",
  "required": ["req", "phase", "agent", "date", "gate"],
  "properties": {
    "req": { "type": "string", "pattern": "^REQ-\\d+(-[a-z0-9-]+)?$", "description": "REQ 编号（可带 slug）" },
    "phase": {
      "type": "string",
      "enum": ["requirements", "architecture", "development", "testing", "delivery"]
    },
    "agent": {
      "type": "string",
      "enum": ["req-analyst", "architect", "developer", "test-engineer", "release-manager"]
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD" },
    "gate": { "type": "string", "enum": ["passed", "failed"] }
  },
  "additionalProperties": true
}
